{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ancher.space/schemas/site.schema.json",
  "title": "PSEO site configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "siteName",
    "canonicalOrigin",
    "defaultLocale",
    "locales",
    "publishedLocales"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "siteName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "canonicalOrigin": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/]+$"
    },
    "defaultLocale": {
      "type": "string",
      "enum": [
        "en",
        "zh-CN"
      ]
    },
    "locales": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "en",
          "zh-CN"
        ]
      }
    },
    "publishedLocales": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "en",
          "zh-CN"
        ]
      }
    }
  }
}
