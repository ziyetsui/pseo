{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pseo-cms-local",
  "main": "src/worker.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "production": {
      "name": "pseo-cms-beta",
      "workers_dev": true,
      "preview_urls": false,
      "limits": {
        "cpu_ms": 30000
      },
      "placement": {
        "mode": "smart"
      },
      "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
      ],
      "vars": {
        "CMS_DATABASE_ADAPTER": "postgres",
        "CMS_POSTGRES_TRANSPORT": "hyperdrive",
        "CMS_DEPLOYMENT_ENV": "production",
        "CMS_PREVIEW_ENABLED": "false",
        "CMS_PUBLIC_SNAPSHOT_ENABLED": "true",
        "PAYLOAD_PUBLIC_SERVER_URL": "https://pseo-cms-beta.codex-cloudflare-20260612.workers.dev"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "REPLACE_WITH_CLOUDFLARE_HYPERDRIVE_ID"
        }
      ]
    }
  }
}
