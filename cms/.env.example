# Payload/Next runtime. Replace this deliberately invalid placeholder with a
# random value of at least 32 characters from a secret store.
PAYLOAD_SECRET=replace-me
DATABASE_URI=postgres://payload:payload@127.0.0.1:5432/pseo_cms
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# Internal beta is intentionally mock-only. Any other value fails closed.
CMS_GIT_PUBLISHER=mock
# Publication requests must name this exact, immutable base revision.
CMS_MOCK_GIT_BASE_SHA=0000000000000000000000000000000000000000
