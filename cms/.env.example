# Payload/Next runtime. Replace this deliberately invalid placeholder with a
# random value of at least 32 characters from a secret store.
PAYLOAD_SECRET=replace-me
# Local development stays on PostgreSQL unless D1 is selected explicitly.
CMS_DATABASE_ADAPTER=postgres
CMS_DEPLOYMENT_ENV=local
CMS_POSTGRES_TRANSPORT=direct
DATABASE_URI=postgres://payload:payload@127.0.0.1:5432/pseo_cms
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001

# The active CMS runtime never receives GitHub write credentials. Do not add
# CMS_GIT_PUBLISHER, GitHub tokens, repository names, or Git base revisions.

# Local-beta draft preview is opt-in and disabled by default. When enabled,
# provide a server-only random token of at least 32 characters. Never expose it
# through NEXT_PUBLIC_* or commit a real value.
CMS_PREVIEW_ENABLED=false
CMS_PREVIEW_TOKEN=

# External mirror snapshot export is separately opt-in and disabled by
# default. Its read-only Bearer token must be server-only and at least 32
# characters. D1 remains fail-closed until an immutable read adapter exists.
CMS_PUBLIC_SNAPSHOT_ENABLED=false
CMS_PUBLIC_SNAPSHOT_TOKEN=
