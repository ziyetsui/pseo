{
  "name": "@pseo/cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:cloudflare": "node --experimental-strip-types scripts/cloudflare-artifact.ts build",
    "build:cloudflare:production": "node --experimental-strip-types scripts/cloudflare-artifact.ts build --env=production",
    "build:cloudflare:postgres": "node --experimental-strip-types scripts/cloudflare-artifact.ts build-postgres",
    "cloudflare:artifact:check": "node --experimental-strip-types scripts/cloudflare-artifact.ts check",
    "cloudflare:postgres:preflight": "node --experimental-strip-types scripts/cloudflare-artifact.ts preflight-postgres",
    "cloudflare:postgres:deploy:dry-run": "node --experimental-strip-types scripts/cloudflare-artifact.ts dry-run-postgres",
    "preview:cloudflare": "pnpm build:cloudflare && pnpm cloudflare:artifact:check && opennextjs-cloudflare preview",
    "deploy:cloudflare": "pnpm build:cloudflare:production && pnpm cloudflare:artifact:check && pnpm cloudflare:deploy:dry-run && pnpm migrate:cloudflare && pnpm cloudflare:artifact:check && node --experimental-strip-types scripts/cloudflare-artifact.ts deploy --env=production",
    "deploy:cloudflare:postgres": "pnpm cloudflare:postgres:preflight && pnpm build:cloudflare:postgres && pnpm cloudflare:artifact:check && pnpm cloudflare:postgres:deploy:dry-run && pnpm migrate:cloudflare:postgres && pnpm cloudflare:artifact:check && node --experimental-strip-types scripts/cloudflare-artifact.ts deploy-postgres",
    "migrate:create:d1": "cross-env CMS_DATABASE_ADAPTER=d1 payload migrate:create",
    "migrate:cloudflare": "node --experimental-strip-types scripts/cloudflare-artifact.ts migrate",
    "migrate:cloudflare:postgres": "node --experimental-strip-types scripts/cloudflare-artifact.ts migrate-postgres",
    "migrate:d1-to-postgres": "node --experimental-strip-types scripts/migrate-d1-to-postgres.ts",
    "cloudflare:deploy:dry-run": "node --experimental-strip-types scripts/cloudflare-artifact.ts dry-run",
    "cloudflare:typegen": "cross-env CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types --env=production --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "start": "next start",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed:first-prompt": "node --experimental-strip-types scripts/seed-first-prompt.ts",
    "seed:wireframe": "node --experimental-strip-types scripts/seed-wireframe.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@payloadcms/db-d1-sqlite": "3.88.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "cross-env": "10.1.0",
    "graphql": "16.11.0",
    "next": "16.3.4",
    "payload": "3.88.0",
    "pg": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "wrangler": "4.116.0"
  }
}
