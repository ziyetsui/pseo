# Choose explicitly. Never silently replace a failed public catalog with visual samples.
FRONTEND_DATA_MODE=public-api
FRONTEND_API_URL=http://127.0.0.1:8000
FRONTEND_EXPECTED_REVISION=
# Required in public-api mode: the actual public HTTPS origin, without a path,
# query, fragment, or credentials. Keep this canonical origin during local API checks.
FRONTEND_SITE_URL=
# Optional verified compiler directory, same revision as the API.
FRONTEND_STATIC_DIR=
# Optional generated-mirror provenance (not a secret).
FRONTEND_MIRROR_SHA=
