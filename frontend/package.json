{
  "name": "pseo-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "FRONTEND_DATA_MODE=visual-fixture next dev --hostname 127.0.0.1",
    "build": "next build --webpack && node scripts/finalize-export.mjs",
    "build:visual": "FRONTEND_DATA_MODE=visual-fixture pnpm build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:static": "node scripts/check-static-output.mjs",
    "generate:api": "node scripts/generate-api.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "node-html-parser": "^9.0.2",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "openapi-typescript": "7.13.0"
  }
}
