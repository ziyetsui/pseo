{
  "name": "pseo-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "extract:wireframe": "node scripts/extract-wireframe.mjs",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=desktop --project=mobile",
    "screenshots": "playwright test --project=screenshots-desktop --project=screenshots-mobile",
    "build:bauhaus": "sh -c 'rm -rf out-bauhaus out.prev; if [ -d out ]; then mv out out.prev; fi; NEXT_PUBLIC_THEME=bauhaus next build && mv out out-bauhaus; status=$?; if [ -d out.prev ]; then mv out.prev out; fi; exit $status'",
    "screenshots:bauhaus": "pnpm build:bauhaus && NEXT_PUBLIC_THEME=bauhaus playwright test --project=screenshots-desktop --project=screenshots-mobile",
    "check:static": "node scripts/check-static-output.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "node-html-parser": "^9.0.2",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
