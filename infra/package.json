{
  "name": "pseo-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:content": "node bin/content.mjs build",
    "build:preview": "node bin/prepare-preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "validate": "node bin/content.mjs validate",
    "verify": "npm run validate && npm test && npm run build:content"
  }
}
