{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/public-prompt-lab/taxonomy.schema.json",
  "title": "Localized reviewed taxonomy",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "type", "axis", "locale", "slug", "name", "description", "status", "selector", "translation"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^(?:cty|mdl)_[a-z0-9_]{3,64}$"},
    "type": {"const": "taxonomy"},
    "axis": {"enum": ["content-type", "model"]},
    "locale": {"type": "string"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "review", "published", "tombstoned"]},
    "selector": {"type": "object", "required": ["field", "value"]},
    "translation": {"type": "object", "required": ["status", "reviewer"]}
  }
}
