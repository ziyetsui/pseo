{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pseo-api-beta",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["python_workers"],
  "find_additional_modules": true,
  "base_dir": "src",
  "preserve_file_names": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/worker_catalog.json"],
      "fallthrough": true
    }
  ]
}
